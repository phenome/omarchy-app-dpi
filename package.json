{
  "name": "omarchy-app-scaling",
  "version": "1.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/phenome/omarchy-app-scaling.git"
  },
  "description": "Per-application scaling manager for Omarchy",
  "type": "module",
  "bin": {
    "omarchy-app-scaling": "./bin/omarchy-app-scaling",
    "omarchy-app-dpi": "./bin/omarchy-app-scaling"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "bun check",
    "test": "bun test",
    "release": "node node_modules/semantic-release/bin/semantic-release.js",
    "release:dry-run": "node node_modules/semantic-release/bin/semantic-release.js --no-ci --dry-run",
    "postinstall": "for f in node_modules/.bin/*; do if [ -L \"$f\" ]; then t=$(readlink -f \"$f\"); rm \"$f\"; ln \"$t\" \"$f\" 2>/dev/null || cp \"$t\" \"$f\"; fi; done"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "lefthook": "^2.2.2",
    "semantic-release": "25.0.9",
    "typescript": "^5.8.0"
  },
  "license": "MIT"
}
